# OpenAI
OPENAI_API_KEY=sk-proj-xxxx

# Microsoft Entra ID / OAuth (optional)
MS_CLIENT_ID=xxx
MS_CLIENT_SECRET=xxx
MS_TENANT_ID=common
MS_REDIRECT_URI=https://krok-ai-back.onrender.com/api/v1/auth/callback/
